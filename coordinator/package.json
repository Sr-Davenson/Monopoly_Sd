{
  "name": "coordinator",
  "version": "1.0.0",
  "description": "Coordinador de sesiones HTTP + WebSocket con mesh entre coordinadores (Taller 6)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "start:a": "node index.js --id coord-a --port 5001 --peer-port 5101",
    "start:b": "node index.js --id coord-b --port 5002 --peer-port 5102",
    "start:c": "node index.js --id coord-c --port 5003 --peer-port 5103",
    "test": "node --test game/monopoly.test.js",
    "simulate": "node game/simulate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  }
}
